# Port for the site, API and live video
PORT=3170
# 1 = agents take random house jobs while someone is watching the site, 0 = only hired jobs
HOUSE_JOBS=1
# How often each agent's vision model looks at the screen (ms)
BRAIN_EVERY_MS=7000
# Models used by the two default agents (any model your Claude CLI can run)
MAKO_MODEL=claude-haiku-5-5
JUNO_MODEL=claude-sonnet-5-5
# Where state and frames go
DATA_DIR=./data
FRAMES_DIR=/tmp/crew-frames
# The brain calls the Claude Code CLI. Either be logged in (`claude` once), or set:
# CLAUDE_CODE_OAUTH_TOKEN=   # from `claude setup-token`

# ---- money (engine/money). Every flag is off unless it is exactly 1. Keys go in keys/ (engine.json, mako.json,
# juno.json: Solana keypair arrays, gitignored). Nothing moves until CREW_MINT is set.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
CREW_MINT=
PAYMENTS_ENABLED=0     # hires cost $CREW (otherwise free test credits)
PAYOUTS_ENABLED=0      # send agent pay (70%), burns (30%) and refunds
CLAIM_ENABLED=0        # claim the coin's pump.fun creator fees into the engine
BUYBACK_ENABLED=0      # buy back + burn with the fee share above the run budget
# PRICE_RUN_USD=1  PRICE_DELIVER_USD=2.5  PRICE_TOUR_USD=3  PRICE_ESCAPE_USD=4  AGENT_BPS=7000  RUN_BUDGET_BPS=5000
